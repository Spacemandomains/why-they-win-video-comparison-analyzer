# Video AI Analyzer — Environment Variables
# Copy this file to .env and fill in your API keys

# === API Keys (set at least one for AI analysis) ===

# Google Gemini (free tier available, recommended)
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI (GPT-4o vision)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic (Claude vision)
# Get key: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Meta Model API (Muse Spark - multimodal, reads images/video/audio)
# Get key: https://dev.meta.ai/  (API Keys in your project)
# Used with --provider meta (base URL defaults to https://api.meta.ai/v1)
MODEL_API_KEY=

# Ollama (local, no key needed — just install ollama + llava)
# https://ollama.com

# === Optional Settings ===
# DEFAULT_PROVIDER=gemini
# WHISPER_MODEL=base
